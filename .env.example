# Copy to .env.local and fill in values. Get them from Vivek / the private handover doc.
# NEVER commit real values — this repo is public.

# ---- Supabase (shiroi-erp2, Mumbai) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---- Postgres (only for ORM / migrations / psql) ----
# Transaction pooler (port 6543) — runtime
DATABASE_URL=
# Session pooler (port 5432) — migrations, pg_dump
DIRECT_URL=

# ---- App ----
NEXT_PUBLIC_ERP_URL=
